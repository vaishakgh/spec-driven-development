# Copy this file to .env and fill in real values — never commit .env to version control

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/payments

# JWT signing secret (HS256) or path to public key (RS256)
JWT_SECRET=replace-with-a-strong-random-secret

# JWT algorithm — must match the signing algorithm used by the auth service
JWT_ALGORITHM=HS256

# Rate limit per authenticated user per minute (constitution: 60)
RATE_LIMIT_PER_MINUTE=60
