# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

# If specified, validates the Maven version.
if [ -n "$MVNW_REPOURL" ] ; then
  distributionUrl="$MVNW_REPOURL/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip"
fi

# OS specific support.
darwin=false
case "$(uname)" in
  Darwin*) darwin=true;;
esac

# Find the project base directory.
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-}"
if [ -z "$MAVEN_PROJECTBASEDIR" ]; then
  MAVEN_PROJECTBASEDIR="$(pwd)"
  while [ ! -f "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties" ]; do
    parent="$(dirname "$MAVEN_PROJECTBASEDIR")"
    if [ "$parent" = "$MAVEN_PROJECTBASEDIR" ]; then
      break
    fi
    MAVEN_PROJECTBASEDIR="$parent"
  done
fi
export MAVEN_PROJECTBASEDIR

wrapperJarFile="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
wrapperUrl=$(grep wrapperUrl "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties" 2>/dev/null | sed 's/wrapperUrl=//')
distributionUrl=$(grep distributionUrl "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties" 2>/dev/null | sed 's/distributionUrl=//')

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_WRAPPER_HOME="${MAVEN_USER_HOME}/wrapper/dists"

distributionUrlName="${distributionUrl##*/}"
distributionUrlNameMain="${distributionUrlName%.*}"
DISTRIBUTION_ID="${distributionUrlNameMain%-bin}"

WRAPPER_DIR="$MAVEN_WRAPPER_HOME/$DISTRIBUTION_ID"
DISTRIBUTION_JAR="$WRAPPER_DIR/apache-maven-3.9.9/bin/mvn"

if [ -f "$DISTRIBUTION_JAR" ]; then
  exec "$DISTRIBUTION_JAR" "$@"
fi

# Download Maven wrapper jar if not present
if [ ! -f "$wrapperJarFile" ]; then
  if command -v curl > /dev/null 2>&1; then
    curl -o "$wrapperJarFile" "$wrapperUrl" 2>/dev/null
  elif command -v wget > /dev/null 2>&1; then
    wget -O "$wrapperJarFile" "$wrapperUrl" 2>/dev/null
  fi
fi

exec "$JAVA_HOME/bin/java" \
  -classpath "$wrapperJarFile" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
